PUBLIC_URL=https://radar.wavedidwhat.com
DATABASE_URL=postgres://radar:password@localhost:5432/radar
REDIS_URL=redis://localhost:6379
MCP_BEARER_TOKEN=        # Claude -> /mcp (48 random chars)
DASHBOARD_TOKEN=         # HQ app -> /api (separate; the only token that can approve)
DASHBOARD_PASSWORD=      # basic auth for /dashboard (user: wave)
TOKEN_ENC_KEY=           # openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PRIMARY_ACCOUNT_EMAIL=   # optional: inbox that owns the tracker sheet + calendar (default: first one connected with Sheets)
JOB_TRACKER_SHEET_ID=    # optional: use an existing sheet; otherwise "Job Radar Tracker" is created on first sync
ALLOWED_RETURN_HOSTS=    # optional: hosts the OAuth callback may return to, e.g. app.example.com
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
GITHUB_TOKEN=            # optional, read-only: only list_projects uses it (pinned repos need it)
GITHUB_USERNAME=         # optional: overrides candidate.github in profile.yaml
SENDING_ENABLED=false    # kill switch
